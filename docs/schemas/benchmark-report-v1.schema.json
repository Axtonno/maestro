{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/benchmark-report-v1.schema.json",
  "title": "Maestro Benchmark Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "completed_at",
    "duration_ms",
    "metadata",
    "configuration",
    "scenarios"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "number", "minimum": 0 },
    "metadata": { "$ref": "#/$defs/metadata" },
    "configuration": { "$ref": "#/$defs/configuration" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario_report" }
    }
  },
  "$defs": {
    "result_state": {
      "enum": ["passed", "failed", "skipped", "unsupported"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_version", "manifest_owner"],
      "properties": {
        "command": { "type": "string" },
        "maestro_version": { "type": "string" },
        "maestro_commit": { "type": "string" },
        "manifest_version": { "const": 1 },
        "manifest_owner": { "type": "string", "minLength": 1 },
        "source_milestone": { "type": "string" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware",
        "provider",
        "model",
        "generation",
        "execution",
        "dataset"
      ],
      "properties": {
        "hardware": { "$ref": "#/$defs/hardware" },
        "provider": { "$ref": "#/$defs/provider" },
        "model": { "$ref": "#/$defs/model" },
        "models": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/model" }
        },
        "plugins": {
          "type": "array",
          "items": { "$ref": "#/$defs/plugin" }
        },
        "generation": { "$ref": "#/$defs/generation" },
        "execution": { "$ref": "#/$defs/execution" },
        "dataset": { "$ref": "#/$defs/dataset" }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "cpu": { "type": "string" },
        "logical_cpus": { "type": "integer", "minimum": 0 },
        "memory_mb": { "type": "integer", "minimum": 0 },
        "gpu": { "type": "string" },
        "backend": { "type": "string" },
        "vram_mb": { "type": "integer", "minimum": 0 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "server_version": { "type": "string" },
        "endpoint": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "digest": { "type": "string" },
        "format": { "type": "string" },
        "quantization": { "type": "string" },
        "context_length": { "type": "integer", "minimum": 0 }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 0 },
        "temperature": { "type": "number", "minimum": 0 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "stop_count": { "type": "integer", "minimum": 0 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cold", "warmup", "runs", "cleanup_timeout_ms"],
      "properties": {
        "cold": { "type": "boolean" },
        "warmup": { "type": "integer", "minimum": 0 },
        "runs": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "number", "minimum": 0 },
        "cleanup_timeout_ms": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "scenario_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "model_role", "cleanup"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "model_role": { "type": "string", "minLength": 1 },
        "cleanup": { "type": "string", "minLength": 1 },
        "mutation_guard": { "type": "string" }
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "warmup"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "warmup": { "type": "boolean" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "method": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "operation": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "status_code": { "type": "integer", "minimum": 0 },
        "retryable": { "type": "boolean" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "started_at", "duration_ms", "state"],
      "properties": {
        "iteration": { "$ref": "#/$defs/iteration" },
        "started_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "number", "minimum": 0 },
        "state": { "$ref": "#/$defs/result_state" },
        "reason_code": { "type": "string" },
        "measurements": {
          "type": "array",
          "items": { "$ref": "#/$defs/measurement" }
        },
        "error": { "$ref": "#/$defs/error" },
        "cleanup_error": { "$ref": "#/$defs/error" }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "count", "min", "median", "max"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "method": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "min": { "type": "number" },
        "median": { "type": "number" },
        "p95": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "scenario_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "state", "samples"],
      "properties": {
        "scenario": { "$ref": "#/$defs/scenario_definition" },
        "state": { "$ref": "#/$defs/result_state" },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sample" }
        },
        "aggregates": {
          "type": "array",
          "items": { "$ref": "#/$defs/aggregate" }
        }
      }
    }
  }
}
