{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/mutation-qualification-report-v1.schema.json",
  "title": "Maestro Mutation Qualification Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "created_at", "completed_at", "duration_ms",
    "profile", "build", "hardware", "gate", "scenario", "required_passes",
    "fail_fast", "state", "samples"
  ],
  "properties": {
    "schema_version": {"const": "mutation-qualification-report/1.0.0"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "number", "minimum": 0},
    "profile": {"$ref": "#/$defs/profile"},
    "build": {"$ref": "#/$defs/build"},
    "hardware": {"$ref": "#/$defs/hardware"},
    "gate": {"enum": ["deterministic", "A", "B", "C"]},
    "scenario": {"type": "string", "minLength": 1, "maxLength": 128},
    "required_passes": {"type": "integer", "minimum": 1},
    "fail_fast": {"const": true},
    "state": {"$ref": "#/$defs/state"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sample"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["passed", "failed", "skipped", "unsupported"]},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest", "target", "model"],
      "properties": {
        "version": {"const": 1},
        "digest": {"$ref": "#/$defs/sha256"},
        "target": {"const": "linux_amd64/ollama"},
        "model": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "maxLength": 128},
        "commit": {"type": "string", "maxLength": 128},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {"type": "string"},
        "architecture": {"type": "string"},
        "cpu": {"type": "string"},
        "logical_cpus": {"type": "integer", "minimum": 0},
        "memory_mb": {"type": "integer", "minimum": 0},
        "gpu": {"type": "string"},
        "backend": {"type": "string"},
        "vram_mb": {"type": "integer", "minimum": 0}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt", "scenario", "evidence_code", "state", "started_at", "duration_ms", "terminal",
        "model_turns", "tool_calls", "mutation_attempts", "approval",
        "lifecycle", "initial_sha256", "expected_sha256", "final_sha256",
        "workspace_digest", "context_freshness", "temporary_cleanup"
      ],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "scenario": {"type": "string", "minLength": 1, "maxLength": 128},
        "evidence_code": {"type": "string", "minLength": 1, "maxLength": 128},
        "state": {"$ref": "#/$defs/state"},
        "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
        "failure_class": {"enum": ["product", "model", "environment", "operator", "harness"]},
        "started_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "number", "minimum": 0},
        "terminal": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_turns": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "mutation_attempts": {"type": "integer", "minimum": 0, "maximum": 1},
        "approval": {"enum": ["not_requested", "allowed_once", "denied", "unavailable"]},
        "lifecycle": {
          "type": "array",
          "items": {
            "enum": [
              "proposal_prepared", "approval_allowed", "approval_denied",
              "apply_started", "apply_succeeded", "apply_failed",
              "reindex_started", "reindex_succeeded", "reindex_failed",
              "terminal_completed", "terminal_failed", "terminal_canceled"
            ]
          }
        },
        "initial_sha256": {"$ref": "#/$defs/sha256"},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "final_sha256": {"$ref": "#/$defs/sha256"},
        "workspace_digest": {"$ref": "#/$defs/sha256"},
        "context_freshness": {"enum": ["fresh", "stale", "not_applicable"]},
        "temporary_cleanup": {"enum": ["clean", "failed", "not_applicable"]}
      }
    }
  }
}
