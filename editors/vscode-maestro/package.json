{
  "name": "maestro-local-ai",
  "displayName": "Maestro for VS Code",
  "description": "Run explicit local AI chat and Controlled Mutation workflows through the Maestro CLI.",
  "version": "0.2.0",
  "publisher": "axtonno",
  "preview": true,
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#08111f",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/Axtonno/maestro.git",
    "directory": "editors/vscode-maestro"
  },
  "bugs": {
    "url": "https://github.com/Axtonno/maestro/issues"
  },
  "homepage": "https://github.com/Axtonno/maestro/tree/master/editors/vscode-maestro#readme",
  "engines": {
    "node": ">=22.12.0",
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "local ai",
    "ollama",
    "php",
    "laravel",
    "code assistant",
    "controlled mutation",
    "privacy"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension launches the resolved local Maestro binary in a workspace terminal."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:maestro.askActiveFile",
    "onCommand:maestro.replaceSelection",
    "onCommand:maestro.doctor",
    "onCommand:maestro.version",
    "onCommand:maestro.openSetupGuide"
  ],
  "contributes": {
    "commands": [
      {
        "command": "maestro.askActiveFile",
        "title": "Maestro: Chat About Active File"
      },
      {
        "command": "maestro.replaceSelection",
        "title": "Maestro: Mutate Selection"
      },
      {
        "command": "maestro.doctor",
        "title": "Maestro: Doctor"
      },
      {
        "command": "maestro.version",
        "title": "Maestro: Show Binary Identity"
      },
      {
        "command": "maestro.openSetupGuide",
        "title": "Maestro: Open Setup Guide"
      }
    ],
    "walkthroughs": [
      {
        "id": "maestro.setup",
        "title": "Set up Maestro",
        "description": "Go from a local CLI to a reviewed chat and Controlled Mutation without leaving VS Code.",
        "when": "workspacePlatform == 'linux'",
        "steps": [
          {
            "id": "maestro.setup.locate",
            "title": "Install or locate Maestro CLI",
            "description": "Install and configure the pinned CLI, then [show its binary identity](command:maestro.version).",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onContext:maestro.binaryReady"
            ]
          },
          {
            "id": "maestro.setup.doctor",
            "title": "Verify the runtime",
            "description": "[Run Maestro Doctor](command:maestro.doctor) and review the authoritative result in the terminal.",
            "media": {
              "markdown": "media/walkthrough/doctor.md"
            },
            "completionEvents": [
              "onContext:maestro.doctorPassed"
            ]
          },
          {
            "id": "maestro.setup.binaryPath",
            "title": "Recover binary detection",
            "description": "If detection fails, [open the binary path setting](command:workbench.action.openSettings?%22%40ext%3Aaxtonno.maestro-local-ai%20maestro.binaryPath%22).",
            "media": {
              "markdown": "media/walkthrough/binary-path.md"
            },
            "completionEvents": [
              "onSettingChanged:maestro.binaryPath",
              "onContext:maestro.binaryReady"
            ]
          },
          {
            "id": "maestro.setup.chat",
            "title": "Chat about the active file",
            "description": "Open a saved local file, then [start a focused chat](command:maestro.askActiveFile).",
            "media": {
              "markdown": "media/walkthrough/chat.md"
            },
            "completionEvents": [
              "onContext:maestro.chatPassed"
            ]
          },
          {
            "id": "maestro.setup.mutation",
            "title": "Review a Controlled Mutation",
            "description": "Select complete lines in a saved `app/*.php` file, then [preview a mutation](command:maestro.replaceSelection).",
            "media": {
              "markdown": "media/walkthrough/mutation.md"
            },
            "completionEvents": [
              "onContext:maestro.mutationReviewed"
            ]
          }
        ]
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "maestro.askActiveFile",
          "group": "maestro@10",
          "when": "resourceScheme == file"
        },
        {
          "command": "maestro.replaceSelection",
          "group": "maestro@20",
          "when": "resourceScheme == file && editorLangId == php && editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Maestro",
      "properties": {
        "maestro.binaryPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Optional Maestro executable path. Default: empty. Example: `/home/me/.local/bin/maestro` or `./bin/maestro`. An explicit path takes precedence over the exact extension-host `PATH`; relative paths resolve from the selected workspace."
        },
        "maestro.configPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Optional Maestro v4 configuration file. Default: empty. Example: `./maestro.yaml`. An explicit workspace-contained path takes precedence; when empty, the CLI uses `MAESTRO_CONFIG`, `XDG_CONFIG_HOME`, then `~/.config/maestro/config.yaml` as created by `maestro setup`."
        },
        "maestro.terminalName": {
          "type": "string",
          "default": "Maestro",
          "scope": "window",
          "description": "Name used for the dedicated integrated terminal."
        }
      }
    }
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:integration",
    "package:vsix": "node test/package-vsix.js",
    "package:list": "vsce ls --no-dependencies",
    "test:unit": "node --test --test-isolation=none test/*.test.js",
    "test:integration": "node test/run-integration.js",
    "test:vsix": "node test/run-vsix-integration.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "mocha": "12.0.0",
    "yauzl": "3.4.0",
    "yazl": "2.5.1"
  }
}
