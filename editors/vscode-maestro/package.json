{
  "name": "maestro-local-ai",
  "displayName": "Maestro for VS Code",
  "description": "Run explicit local AI chat and Controlled Mutation workflows through the Maestro CLI.",
  "version": "0.1.1",
  "publisher": "axtonno",
  "preview": true,
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#08111f",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/Axtonno/maestro.git",
    "directory": "editors/vscode-maestro"
  },
  "bugs": {
    "url": "https://github.com/Axtonno/maestro/issues"
  },
  "homepage": "https://github.com/Axtonno/maestro/tree/master/editors/vscode-maestro#readme",
  "engines": {
    "node": ">=22.12.0",
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "local ai",
    "ollama",
    "php",
    "laravel",
    "code assistant",
    "controlled mutation",
    "privacy"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension launches the resolved local Maestro binary in a workspace terminal."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onCommand:maestro.askActiveFile",
    "onCommand:maestro.replaceSelection",
    "onCommand:maestro.doctor",
    "onCommand:maestro.version"
  ],
  "contributes": {
    "commands": [
      {
        "command": "maestro.askActiveFile",
        "title": "Maestro: Ask About Active File"
      },
      {
        "command": "maestro.replaceSelection",
        "title": "Maestro: Replace Selected Lines"
      },
      {
        "command": "maestro.doctor",
        "title": "Maestro: Run Doctor"
      },
      {
        "command": "maestro.version",
        "title": "Maestro: Show Binary Identity"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "maestro.askActiveFile",
          "group": "maestro@10",
          "when": "resourceScheme == file"
        },
        {
          "command": "maestro.replaceSelection",
          "group": "maestro@20",
          "when": "resourceScheme == file && editorLangId == php && editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Maestro",
      "properties": {
        "maestro.binaryPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional Maestro executable path. Relative paths resolve from the selected workspace; when empty, the extension searches the exact extension-host PATH without a shell."
        },
        "maestro.configPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional Maestro v4 configuration file. When empty, the CLI uses the configuration created by maestro setup. Relative paths resolve inside the selected workspace."
        },
        "maestro.terminalName": {
          "type": "string",
          "default": "Maestro",
          "scope": "window",
          "description": "Name used for the dedicated integrated terminal."
        }
      }
    }
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:integration",
    "package:vsix": "node test/package-vsix.js",
    "package:list": "vsce ls --no-dependencies",
    "test:unit": "node --test --test-isolation=none test/*.test.js",
    "test:integration": "node test/run-integration.js",
    "test:vsix": "node test/run-vsix-integration.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "mocha": "12.0.0",
    "yauzl": "3.4.0",
    "yazl": "2.5.1"
  }
}
